{
  "name": "kingshot-data-platform",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "EAGLEEYE_ENV": "production",
    "DISCORD_CLIENT_ID": "1552660062063829093",
    "DISCORD_REDIRECT_URI": "https://kingshot-data-platform.black-jack-kingshot.workers.dev/api/auth/callback",
    "CLOUDFLARE_ACCOUNT_ID": "991e65e37de26f2e996fe296ab0d1a3a",
    "CLOUDFLARE_D1_DATABASE_ID": "0024b5df-4dcf-45f7-b9a7-6fa621cbb80a",
    "HISTORY_STORAGE_MODE": "R2_ONLY",
    "CLOUDFLARE_MONITORING_PROFILE": "PAID_5USD",
    "CLOUDFLARE_USD_JPY_RATE": "157.50",
    "GOOGLE_OAUTH_CLIENT_ID": "431040963469-pjv0mpc3ap509gm8st2mva0879l9pa27.apps.googleusercontent.com",
    "GOOGLE_DRIVE_OAUTH_REDIRECT_URI": "https://kingshot-data-platform.black-jack-kingshot.workers.dev/api/auth/callback",
    "GOOGLE_DRIVE_FOLDER_ID": "1w34yYvP7FswaOsDn1u4BD0jQtNrhmJXE"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eagleeye-db",
      "database_id": "0024b5df-4dcf-45f7-b9a7-6fa621cbb80a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "eagleeye-archive"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SERVICE_USAGE_QUEUE",
        "queue": "eagleeye-service-usage"
      },
      {
        "binding": "LOAD_TEST_QUEUE",
        "queue": "eagleeye-load-test"
      }
    ],
    "consumers": [
      {
        "queue": "eagleeye-service-usage",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "eagleeye-service-usage-dlq"
      },
      {
        "queue": "eagleeye-load-test",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "eagleeye-load-test-dlq"
      }
    ]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "previews": {
    "vars": {
      "EAGLEEYE_ENV": "preview",
      "DISCORD_CLIENT_ID": "1552660062063829093",
      "DISCORD_REDIRECT_URI": "https://kingshot-data-platform.black-jack-kingshot.workers.dev/api/auth/callback",
      "CLOUDFLARE_ACCOUNT_ID": "991e65e37de26f2e996fe296ab0d1a3a",
      "CLOUDFLARE_D1_DATABASE_ID": "0024b5df-4dcf-45f7-b9a7-6fa621cbb80a",
      "HISTORY_STORAGE_MODE": "R2_ONLY",
      "CLOUDFLARE_MONITORING_PROFILE": "PAID_5USD",
      "CLOUDFLARE_USD_JPY_RATE": "157.50",
      "GOOGLE_OAUTH_CLIENT_ID": "431040963469-pjv0mpc3ap509gm8st2mva0879l9pa27.apps.googleusercontent.com",
      "GOOGLE_DRIVE_OAUTH_REDIRECT_URI": "https://kingshot-data-platform.black-jack-kingshot.workers.dev/api/auth/callback",
      "GOOGLE_DRIVE_FOLDER_ID": "1w34yYvP7FswaOsDn1u4BD0jQtNrhmJXE"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "eagleeye-db",
        "database_id": "0024b5df-4dcf-45f7-b9a7-6fa621cbb80a"
      }
    ],
    "r2_buckets": [
      {
        "binding": "ARCHIVE",
        "bucket_name": "eagleeye-archive"
      }
    ],
    "queues": {
      "producers": [
        {
          "binding": "SERVICE_USAGE_QUEUE",
          "queue": "eagleeye-service-usage"
        },
        {
          "binding": "LOAD_TEST_QUEUE",
          "queue": "eagleeye-load-test"
        }
      ]
    },
    "version_metadata": {
      "binding": "CF_VERSION_METADATA"
    }
  },
  "secrets": {
    "required": [
      "DISCORD_CLIENT_SECRET",
      "DISCORD_BOT_TOKEN",
      "DISCORD_PUBLIC_KEY",
      "DISCORD_SUPPORT_GUILD_ID",
      "DISCORD_SUPPORT_CATEGORY_ID",
      "DISCORD_SUPPORT_ROLE_ID",
      "DISCORD_SUPPORT_ARCHIVE_CATEGORY_ID",
      "EAGLEEYE_SESSION_SECRET",
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "GOOGLE_DRIVE_REFRESH_TOKEN"
    ]
  },
  "limits": {
    "cpu_ms": 300000
  }
}
